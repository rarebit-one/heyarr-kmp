<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A Compose app only needs a no-action-bar base theme; dark, with the design
         system's base surface as the window background so the first frame does not flash white. -->
    <style name="Theme.Heyarr" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF080709</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The PDF viewer only (reader/PdfReaderFragment): Jetpack's PdfViewerFragment builds
         its search bar, page indicator and fast scroller from Material Components, which
         refuse a non-Material theme. Dark, on the reader's base surface. -->
    <style name="Theme.Heyarr.Pdf" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#FF0A1410</item>
        <item name="colorSurface">#FF0A1410</item>
    </style>
</resources>
