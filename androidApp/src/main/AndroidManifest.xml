<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The login broker, library API, blob stream and personal-state sync are all network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The device signing key's hardware wrapping key is user-presence gated (BiometricPrompt). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- The camera scans the `void-which-binds:pair?…` invite QR the Mac prints during enrolment.
         Optional so the app still installs on camera-less devices; Enrol keeps the paste path. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- A pairing with Cruciform on this phone has the user switching apps for minutes; the
         relay wait runs in an app-scoped holder under a "Pairing with Cruciform…" foreground
         service (device/PairingForegroundService) so the process is not killed meanwhile. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The audio queue plays under a MediaSessionService (playback/PlaybackService): music
         keeps going when the app is backgrounded, with notification / lock-screen controls. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility (Android 11+): let us resolve the Cruciform authenticator app for the
         same-phone `void-which-binds:` hand-off, so the "Approve on this phone" / "Open in
         Cruciform" buttons only show when something actually handles the scheme. Gen2 only
         (void-which-binds-go ADR-0022): Cruciform 1.0.0+ registers `void-which-binds:` alone,
         and there is deliberately no gen1 `voidbind:` query beside it. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="void-which-binds" />
        </intent>
        <!-- The same-phone one-tap report we fire back at Cruciform once we have joined
             its invite and derived the SAS (void-which-binds-kmp ADR-0008). The <data> must match
             Cruciform's filter exactly — scheme AND host — or the launch is invisible to
             us and we silently fall back to the human SAS comparison. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="cruciform" android:host="pair-joined" />
        </intent>
    </queries>

    <application
        android:name=".HeyarrApp"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_slideshow"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Heyarr">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- `heyarr-mobile://login` — the callback the authenticator may open after
                 approving a handed-off login, to bring us back to the foreground. The
                 outcome itself still arrives by polling GET /login/{id}. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="heyarr-mobile" android:host="login" />
            </intent-filter>
            <!-- `heyarr-mobile://pair?invite=<encoded void-which-binds:pair tuple>` — the REVERSE
                 same-phone handoff (void-which-binds-kmp ADR-0006): Cruciform's "Add a device" hands
                 us the invite it minted, since we can't scan the screen we share. Routed by
                 device/PairDeepLink into the same join path a scan takes; the SAS is then
                 confirmed on Cruciform. singleTop: a warm app gets it via onNewIntent. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="heyarr-mobile" android:host="pair" />
            </intent-filter>
            <!-- Same-phone handoff DISCOVERY (void-which-binds-kmp ADR-0009): advertise to
                 Cruciform that we can receive a Void-Which-Binds pairing handoff, so it lists a
                 "Send to heyarr on this phone" button WITHOUT a hard-coded registry entry.
                 Data-less by design — Cruciform's discovery probe (a VIEW intent carrying
                 only the RP_HANDOFF category) cannot match a scheme://pair filter, so this
                 dedicated filter advertises the capability and the meta-data below names
                 the scheme Cruciform should fire (heyarr-mobile://pair, the filter above).
                 The category and meta-data key are Cruciform 1.0.0's gen2 names
                 (`one.rarebit.voidwhichbinds.*`, ADR-0022); a gen2 Cruciform does not look
                 for the gen1 `one.rarebit.voidbind.*` ones, so those are gone. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="one.rarebit.voidwhichbinds.category.RP_HANDOFF" />
            </intent-filter>
            <meta-data
                android:name="one.rarebit.voidwhichbinds.rp.pair_scheme"
                android:value="heyarr-mobile" />
            <!-- `heyarr-mobile://pair-done?session=…` — the return leg of the same-phone
                 one-tap enrolment (void-which-binds-kmp ADR-0008). Cruciform opens it once it has
                 signed and delivered the admission, so the human lands back here, on the
                 Device tab, enrolled. It carries the session id only: the admission itself
                 arrived sealed over the relay, and this link grants nothing. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="heyarr-mobile" android:host="pair-done" />
            </intent-filter>
        </activity>

        <!-- Holds the process alive while a pairing is in flight (see the permissions above). -->
        <service
            android:name=".device.PairingForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- The reader: a Readium navigator in its own activity (fragment-hosted), launched
             from the reader entry screen with the file's authenticated blob URL. -->
        <activity
            android:name=".reader.ReaderActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Heyarr" />

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
